#include <zephyr/dt-bindings/adc/adc.h>

/ {
	zephyr,user {
		/* Arduino A0 = PB1 = ADC1_IN5 en esta placa. */
		io-channels = <&adc1 5>;
	};
};

&adc1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@5 {
		reg = <5>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

/*
 * Zephyr 4.4.2 declara STOP0/1/2 para STM32WL, pero no proporciona
 * exit-latency-us. Sin estos valores una peticion de latencia no filtraria
 * ningun estado. Los valores 4/8/9 us son metadata experimental, redondeada
 * con margen a partir de los tiempos de despertar del silicio publicados por
 * ST. No sustituyen una caracterizacion extremo a extremo de esta aplicacion.
 */
&stop0 {
	exit-latency-us = <4>;
};

&stop1 {
	exit-latency-us = <8>;
};

&stop2 {
	exit-latency-us = <9>;
};
